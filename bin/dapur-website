#!/usr/bin/env php
<?php

/**
 * Perintah pengelolaan multi-website Dapur AdeMS. Jalankan dari folder inti:
 *
 *   vendor/bin/dapur-website buat-website <domain> [--lokasi=<folder>] [--terpusat] [--alias=<a,b>] [--judul=<judul>]
 *   vendor/bin/dapur-website daftar-website
 *   vendor/bin/dapur-website clear-config-cache --semua
 *
 * Pada Dapur AdeMS 2.5 atau lebih baru, perintah yang sama tersedia lewat `php dapur`.
 */

declare(strict_types=1);

use AdeMS\Dapur\MultiWebsite\Bootstrap;
use AdeMS\Dapur\MultiWebsite\Perintah;

require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__, 3) . '/autoload.php';

exit((new Perintah(Bootstrap::folderInti()))->jalankan(array_values(array_slice($argv, 1))));
