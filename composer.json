{
    "name": "adems/dapur-multiwebsite",
    "description": "Modul multi-website untuk Dapur AdeMS: satu inti Dapur melayani banyak website",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "dapur",
        "adems",
        "laminas",
        "mezzio",
        "multiwebsite",
        "multisite"
    ],
    "homepage": "https://www.adems.id",
    "authors": [
        {
            "name": "Ade M Saragih",
            "homepage": "https://www.adems.id"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "composer-runtime-api": "^2.0",
        "laminas/laminas-config-aggregator": "^1.20",
        "mezzio/mezzio": "^3.28",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-diactoros": "^3.9",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "AdeMS\\Dapur\\MultiWebsite\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AdeMS\\Dapur\\MultiWebsite\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/dapur-website"
    ],
    "scripts": {
        "test": "phpunit"
    }
}
